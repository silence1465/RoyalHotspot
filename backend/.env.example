APP_NAME="Hotspot Billing System"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
SANCTUM_EXPIRATION=480
APP_TIMEZONE=Africa/Accra
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

# API versioning prefix used in routes/api.php (see review note on versioning)
API_VERSION=v1

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hotspot_billing
DB_USERNAME=hotspot_user
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

# Queue MUST be a real driver (not sync) in production — MikroTik activation
# and expiry jobs are dispatched async so Paystack webhooks return fast.
QUEUE_CONNECTION=database

CACHE_STORE=database

SANCTUM_STATEFUL_DOMAINS=localhost:5173
SANCTUM_TOKEN_EXPIRATION=

# ── Paystack ──────────────────────────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_CALLBACK_URL=http://localhost:5173/payment/callback
PAYSTACK_CURRENCY=GHS
PAYSTACK_FALLBACK_EMAIL_DOMAIN=freedomdata.shop

# ── MikroTik / WireGuard ─────────────────────────────────
# Individual router credentials live in the `routers` table (api_password
# encrypted at rest via Laravel's `encrypted` cast). These env vars are only
# defaults/fallbacks used by artisan commands and seeders.
MIKROTIK_DEFAULT_API_PORT=8729
MIKROTIK_USE_SSL=true
MIKROTIK_CONNECTION_TIMEOUT=5
MIKROTIK_SOCKET_TIMEOUT=30

# Generate safely with: php artisan mikrotik:security-key
# Never place the plaintext security key in this file.
MIKROTIK_ADMIN_SECURITY_KEY_HASH=
MIKROTIK_ADMIN_UNLOCK_MINUTES=15
MIKROTIK_ADMIN_UNLOCK_SLIDING=false
MIKROTIK_ALLOWED_ADDRESS_LISTS=royal-hotspot-allow,royal-hotspot-block
# Interfaces the web application must never move or remove from a bridge.
MIKROTIK_PROTECTED_INTERFACES=ether1,wan,wireguard1,wg0

# Grace period (minutes) applied in subscriptions:expire before a customer's
# MikroTik hotspot user is actually disabled after expires_at. See
# SubscriptionService::isWithinGracePeriod().
DEFAULT_GRACE_PERIOD_MINUTES=0

FRONTEND_URL=http://localhost:5173

# ── Seeders (Phase 2) ─────────────────────────────────────
# Used by AdminUserSeeder / RouterSeeder. Never commit real values —
# these are local-dev-only fallbacks, see the seeder classes for the
# "generate a random one-time password" fallback if left unset.
DEFAULT_ADMIN_EMAIL=admin@hotspotbilling.test
DEFAULT_ADMIN_PASSWORD=
SAMPLE_ROUTER_WIREGUARD_IP=10.10.0.2
SAMPLE_ROUTER_API_USER=api-admin
SAMPLE_ROUTER_API_PASSWORD=change-me-in-env

# ── Royal WiFi extension (Extension Phase 2+) ─────────────
FILESYSTEM_DISK=local

# PDF voucher import — see config/voucherimport.php for every tunable
# (code regex, package header regex). OCR is off by default; see
# docs/DEPLOYMENT_GUIDE.md for the optional system packages it needs.
VOUCHER_PDF_MAX_KB=10240
VOUCHER_PDF_OCR_ENABLED=false

# ── Royal WiFi extension (Extension Phase 4) ──────────────
# Mail — used for the voucher purchase confirmation email. MAIL_MAILER=log
# is a good local-dev default (writes rendered emails to the log instead
# of actually sending) — switch to smtp with real credentials for staging/prod.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@royalwifi.test
MAIL_FROM_NAME="Royal WiFi"

# Shared secret the SMS Forwarder app presents as a Bearer token —
# generate a long random value, e.g. `php artisan tinker --execute="echo Str::random(40);"`
SMS_FORWARDER_TOKEN=

# momo_number / momo_account_name / order_expiry_minutes are stored in
# system_settings (admin-editable via Settings page), not env vars — see
# Admin\SettingController. Nothing to set here for those.

# Extension Phase 5 — off by default. See config/voucherimport.php and
# app/Services/VoucherUsageSyncService.php: reuses the EXISTING
# MikrotikService to check whether a voucher code has actually been used
# on its router. Validate with the on-demand single-voucher check
# (POST /admin/vouchers/{id}/check-mikrotik-status) before enabling bulk
# sync — it assumes the voucher code IS the RouterOS hotspot username.
VOUCHER_MIKROTIK_SYNC_ENABLED=false
